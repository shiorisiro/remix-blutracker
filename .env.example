# Required server environment variables (example)

# Server-only (DO NOT expose these to client builds)
SUPABASE_URL=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=

# Client-only (prefixed with VITE_ and used at build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=

# Comma-separated CORS origins allowed in production (required in production)
CORS_ORIGINS=

# Rate limit tuning
RATE_LIMIT_MAX=60
GEMINI_RATE_LIMIT_MAX=10
GEMINI_MAX_CONTENT_LENGTH=50000

# NOTE: Do NOT use ALLOW_LOCAL_FALLBACK in production. Remove this variable from production environments.
