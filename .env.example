# Required server environment variables (example)

# Supabase server URL and anon/service key (server-only; do not expose in client)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini API key (server-side secret)
GEMINI_API_KEY=

# Comma-separated CORS origins allowed in production (leave blank to allow all origins for non-browser clients)
CORS_ORIGINS=

# Rate limit tuning
RATE_LIMIT_MAX=60
GEMINI_RATE_LIMIT_MAX=10
GEMINI_MAX_CONTENT_LENGTH=50000

# Allow a local fallback mock user when developing (set only in development)
ALLOW_LOCAL_FALLBACK=false
